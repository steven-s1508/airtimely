{
	"name": "airtimely-server",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"description": "Airtimely backend v2 — read-only Hono API + croner worker over Postgres 18",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		}
	},
	"types": "./dist/index.d.ts",
	"engines": {
		"node": ">=22"
	},
	"scripts": {
		"build": "tsc -p tsconfig.json && node scripts/copy-sql.mjs",
		"prepare": "npm run build",
		"typecheck": "tsc -p tsconfig.json --noEmit",
		"start:api": "node dist/main.js",
		"start:worker": "node dist/main.js",
		"dev:api": "cross-env APP_ROLE=api tsx watch src/main.ts",
		"dev:worker": "cross-env APP_ROLE=worker tsx watch src/main.ts",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"pretest": "drizzle-kit migrate",
		"test": "node --import tsx --test --test-concurrency=1 test/*.test.ts",
		"test:unit": "node --import tsx --test test/rateLimit.test.ts test/themeparks.test.ts"
	},
	"dependencies": {
		"@hono/node-server": "^1.13.0",
		"croner": "^9.0.0",
		"drizzle-orm": "^0.44.0",
		"hono": "^4.9.0",
		"luxon": "^3.7.2",
		"postgres": "^3.4.5"
	},
	"devDependencies": {
		"@types/luxon": "^3.7.1",
		"@types/node": "^22.10.0",
		"cross-env": "^7.0.3",
		"drizzle-kit": "^0.31.0",
		"tsx": "^4.19.0",
		"typescript": "^5.9.3"
	}
}
