# Which half of the process tree this container runs: api | worker
APP_ROLE=api

# Coolify-managed Postgres 18, private network only — never expose 5432.
DATABASE_URL=postgres://user:password@postgres:5432/airtimely

# Port the api role listens on. Ignored by the worker.
PORT=3000

# ThemeParks.wiki free key. Only the /history* endpoints authenticate with it.
# Free tier: 30-day window, 600 history requests/hour, 1 request per park-day.
# Migrated from the Windmill variable u/steven_s1508/THEMEPARKS_API_KEY.
THEMEPARKSWIKI_API_KEY=

# Dead-man ping hit after each successful live poll (healthchecks.io / Uptime Kuma).
# Absence of this is what hid the 4-day Windmill outage in September 2026.
HEALTHCHECK_PING_URL=
