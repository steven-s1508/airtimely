# Base URL of the Airtimely API (the server/ workspace), without a trailing slash.
# Embedded into the bundle at build time — set it in the EAS environment for builds.
# Local dev against `npm --workspace server run dev:api`:
#   Android emulator: http://10.0.2.2:3000
#   physical device:  http://<your LAN IP>:3000
EXPO_PUBLIC_API_URL=
